<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Audi ПИК{% endblock %}</title>
        <meta name="description" content="{% block description %} {% endblock %}">
        <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noodp, noimageindex, notranslate, nocache" />

        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {# <link rel="stylesheet" href="{{ asset('css/reset.minify.css') }}" type="text/css"> #}
            {# <link rel="stylesheet" href="{{ asset('css/fonts.minify.css') }}" type="text/css"> #}
            <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}" type="text/css">
            <link rel="stylesheet" href="{{ asset('css/fontawesome-free-6.0.0-web/css/all.min.css') }}" type="text/css">
            <link rel="stylesheet" href="{{ asset('slick/slick.minify.css') }}" type="text/css">
            <link rel="stylesheet" href="{{ asset('slick/slick-theme.minify.css') }}" type="text/css">
            {#<link rel="stylesheet" href="{{ asset('css/style.minify.css?v=004') }}" type="text/css">#}
            <link rel="stylesheet" href="{{ asset('css/style.min.css') }}?v=004" type="text/css">
            <link rel="stylesheet" href="{{ asset('css/special-offers.css') }}" type="text/css">
            <link rel="preload" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
            {# <link rel="stylesheet" href="{{ asset('css/media.minify.css') }}" type="text/css"> #}
            {# <link rel="stylesheet" href="{{ asset('magnific/magnific-popup.minify.css') }}" type="text/css"> #}
            {# <link rel="stylesheet" href="{{ asset('css/popup.minify.css') }}" type="text/css"> #}
            {# <link rel="stylesheet" href="{{ asset('css/indigo-quiz.css') }}" type="text/css"> #}
            {# <link rel="stylesheet" href="{{ asset('css/video-widget.css') }}" type="text/css"> #}
            {# <link rel="stylesheet" href="{{ asset('css/header.css') }}" type="text/css"> #}
            <noscript>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
            </noscript>
            <link rel="stylesheet" href="{{ asset('css/custom.css') }}" type="text/css">
            

            {{ include('scripts/metrika.html.twig') }}
            {#{ include('scripts/roistat.html.twig') }#}
            {{ include('scripts/quiz.html.twig') }}

        {% endblock %}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css">
		<script async src="https://af.click.ru/af.js?id=20832"></script>
    </head>
    <body>

        {% block body %}
        {% block header%}{% endblock%}
        {% block map %}{% endblock %}
        {% block footer %}{% endblock %}
        {% endblock %}

        {% block javascripts %}
            {# <script defer type="text/javascript" src="{{ asset('js/lazysizes.min.js') }}"></script> #}
            <script type="text/javascript" src="{{ asset('js/jquery.min.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/fancybox.js') }}"></script>
            <script defer type="text/javascript" src="{{ asset('js/jquery-migrate-1.2.1.min.js') }}"></script>
            <script defer type="text/javascript" src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
            <script defer src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
            <script  type="text/javascript" src="{{ asset('slick/slick.min.js') }}"></script>
            <script defer type="text/javascript" src="{{ asset('js/jquery.inputmask.minify.js') }}"></script>
            {#<script defer type="text/javascript" src="{{ asset('js/custom.minify.js?v=0.0001') }}"></script>#}
            <script defer type="text/javascript" src="{{ asset('js/custom.js') }}?v=0.0002"></script>
            <script defer type="text/javascript" src="{{ asset('magnific/jquery.magnific-popup.minify.js') }}"></script>
            {# <script defer type="text/javascript" src="{{ asset('js/indigo-quiz.js') }}"></script> #}
            {# <script defer type="text/javascript" src="{{ asset('js/roistat.js') }}"></script> #}
			{# <script type="text/javascript" src="{{ asset('js/add.js?v=0.0003') }}"></script> #}
			<script src="js/validate-custom.js"></script>
            
			
            
            {# <script defer type="text/javascript" src="{{ asset('js/video-widget.js') }}"></script> #}
            <div class="video-widget" data-state="default">
              <div class="video-widget__container">
                <video id="video-widget__video" loop="" autoplay="" playsinline="" preload="auto" muted="muted" controlslist="nodownload" disablepictureinpicture="" class="video-widget__video" src="{{ asset('video/pik_2-vag.mp4?dl=0') }}">
                  <source src="{{ asset('video/pik_2-vag.mp4') }}" type="video/mp4">
                </video>
                <div class="video-widget__close"></div>
              </div>
            </div>

        {% endblock %}
    </body>
</html>
