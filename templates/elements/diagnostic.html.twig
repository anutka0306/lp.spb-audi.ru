<section class="diagnostic-callback">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2>Запишитесь на диагностику прямо сейчас</h2>
            </div>
            <div class="col-12 diagnostic-callback__form">
                <form action="#">
                    <input type="text" id="popup1_name" name="popup1_name" placeholder="Ваше имя">
                    <input type="tel" id="popup1_tel"{#name="popup1_tel"#} name="phone" placeholder="Номер телефона">
                    
                    {#<input type="hidden" id="popup1_address" name="popup1_address" value="V11">#}
					<select id="popup1_address" name="popup1_address">
                            <option value="">Выберите адрес</option>
                            <option value="СПБ4">Санкт-Петербург, Турухтанные Острова, 12</option>
                            <option value="В2АЕ">Санкт-Петербург, ул. Ворошилова д. 2АЕ</option>
                            <option value="К20">Любой адрес</option>
                    </select>
                    
                    <div class="diagnostic-callback__form_btn-container">
                        <input class="popup1_send" type="submit" value="Отправить" onclick="ym(87965785,'reachGoal','send_callback'); return true;">
                    </div>
                </form>
            </div>
            <div class="col-12 diagnostic-callback__footer">
                <div class="header__phone_icon">
                    <img class="lazyload" data-sizes="auto"
                     data-src="/images/tel-icon.webp" alt="">
                </div>
                <span class="header__phone_icon_text">или позвоните нам по номеру <br> +7 (812) 945-75-86</span>
            </div>
        </div>
    </div>
</section>